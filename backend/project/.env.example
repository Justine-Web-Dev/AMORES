# Local development (.env) or Render Environment variables

SECRETKEY=your-django-secret-key

# Option A (recommended on Render): Neon unpooled connection string
# Get this from Neon dashboard -> Connection details -> Direct connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Option B: individual vars (use direct host, NOT the -pooler host)
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your-password
DB_HOST=ep-example.c-2.ap-southeast-1.aws.neon.tech
DB_PORT=5432

CLOUD_NAME=your-cloudinary-cloud
API_KEY=your-cloudinary-key
API_SECRET=your-cloudinary-secret

# Optional
DEBUG=false
CORS_ALLOWED_ORIGINS=https://amores-two.vercel.app
CSRF_TRUSTED_ORIGINS=https://amores-two.vercel.app
